      <item ident="ITEM_MULTI" label="LABEL_MULTI" title="MULTI">
        <itemmetadata>
          <qtimetadata>
            <qti_metadatafield>
              <fieldlabel>qmd_questiontype</fieldlabel>
              <fieldentry>Multi-Select</fieldentry>
            </qti_metadatafield>
            <qti_metadatafield>
              <fieldlabel>qmd_weighting</fieldlabel>
              <fieldentry>1</fieldentry>
            </qti_metadatafield>
            <qti_metadatafield>
              <fieldlabel>qmd_globalid</fieldlabel>
              <fieldentry>synthetic-MULTI</fieldentry>
            </qti_metadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Synthetic prompt MULTI&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="MULTI_RESPONSE" rcardinality="Multiple">
            <render_choice>
              <response_label ident="MULTI_SOURCE_1">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Same label&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="MULTI_SOURCE_2">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Other&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="MULTI_SOURCE_3">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Same label&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar vartype="Integer" defaultval="0" />
          </outcomes>
          <respcondition>
            <conditionvar>
              <and>
                <varequal respident="MULTI_RESPONSE">MULTI_SOURCE_1</varequal>
                <varequal respident="MULTI_RESPONSE">MULTI_SOURCE_2</varequal>
                <not>
                  <varequal respident="MULTI_RESPONSE">MULTI_SOURCE_3</varequal>
                </not>
              </and>
            </conditionvar>
            <setvar action="Set">100</setvar>
          </respcondition>
          <respcondition>
            <conditionvar />
            <setvar action="Set">0</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ITEM_ORDER" label="LABEL_ORDER" title="ORDER">
        <itemmetadata>
          <qtimetadata>
            <qti_metadatafield>
              <fieldlabel>qmd_questiontype</fieldlabel>
              <fieldentry>Ordering</fieldentry>
            </qti_metadatafield>
            <qti_metadatafield>
              <fieldlabel>qmd_weighting</fieldlabel>
              <fieldentry>1</fieldentry>
            </qti_metadatafield>
            <qti_metadatafield>
              <fieldlabel>qmd_globalid</fieldlabel>
              <fieldentry>synthetic-ORDER</fieldentry>
            </qti_metadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Synthetic prompt ORDER&lt;/p&gt;</mattext>
          </material>
          <response_grp respident="ORDER_RESPONSE" rcardinality="Ordered">
            <render_choice>
              <response_label ident="ORDER_SOURCE_1">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;First&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ORDER_SOURCE_2">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Second&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ORDER_SOURCE_3">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Third&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_grp>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar vartype="Integer" defaultval="0" varname="D2L_Correct" minvalue="0" />
            <decvar vartype="Integer" defaultval="0" varname="D2L_Incorrect" minvalue="0" />
            <decvar vartype="Integer" defaultval="0" varname="que_score" minvalue="0" />
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="ORDER_SOURCE_1">1</varequal>
            </conditionvar>
            <setvar action="Add" varname="D2L_Correct">1</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <not>
                <varequal respident="ORDER_SOURCE_1">1</varequal>
              </not>
            </conditionvar>
            <setvar action="Add" varname="D2L_Incorrect">1</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <varequal respident="ORDER_SOURCE_2">2</varequal>
            </conditionvar>
            <setvar action="Add" varname="D2L_Correct">1</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <not>
                <varequal respident="ORDER_SOURCE_2">2</varequal>
              </not>
            </conditionvar>
            <setvar action="Add" varname="D2L_Incorrect">1</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <varequal respident="ORDER_SOURCE_3">3</varequal>
            </conditionvar>
            <setvar action="Add" varname="D2L_Correct">1</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <not>
                <varequal respident="ORDER_SOURCE_3">3</varequal>
              </not>
            </conditionvar>
            <setvar action="Add" varname="D2L_Incorrect">1</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <vargte respident="D2L_Incorrect">0</vargte>
            </conditionvar>
            <setvar action="Set" varname="que_score">0</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <varequal respident="D2L_Incorrect">0</varequal>
            </conditionvar>
            <setvar action="Set" varname="que_score">1</setvar>
          </respcondition>
        </resprocessing>
      </item>
