<?xml version='1.0' encoding='utf-8'?>
<questestinterop>
  <assessment ident="QUIZ_CHOICE_FIDELITY" title="Synthetic choice fidelity">
    <section ident="SECTION_1" title="Synthetic choices">
      <item ident="ITEM_DUPLICATE" label="LABEL_DUPLICATE" title="DUPLICATE">
        <itemmetadata>
          <qtimetadata>
            <qti_metadatafield>
              <fieldlabel>qmd_questiontype</fieldlabel>
              <fieldentry>Multiple Choice</fieldentry>
            </qti_metadatafield>
            <qti_metadatafield>
              <fieldlabel>qmd_weighting</fieldlabel>
              <fieldentry>1</fieldentry>
            </qti_metadatafield>
            <qti_metadatafield>
              <fieldlabel>qmd_globalid</fieldlabel>
              <fieldentry>synthetic-DUPLICATE</fieldentry>
            </qti_metadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Synthetic prompt DUPLICATE&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="DUPLICATE_RESPONSE" rcardinality="Single">
            <render_choice>
              <response_label ident="DUPLICATE_SOURCE_1">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Same label&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="DUPLICATE_SOURCE_2">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Other&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="DUPLICATE_SOURCE_3">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Same label&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <respcondition>
            <conditionvar>
              <varequal respident="DUPLICATE_RESPONSE">DUPLICATE_SOURCE_1</varequal>
            </conditionvar>
            <setvar action="Set">100</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <varequal respident="DUPLICATE_RESPONSE">DUPLICATE_SOURCE_2</varequal>
            </conditionvar>
            <setvar action="Set">0</setvar>
          </respcondition>
          <respcondition>
            <conditionvar>
              <varequal respident="DUPLICATE_RESPONSE">DUPLICATE_SOURCE_3</varequal>
            </conditionvar>
            <setvar action="Set">0</setvar>
          </respcondition>
        </resprocessing>
      </item>
