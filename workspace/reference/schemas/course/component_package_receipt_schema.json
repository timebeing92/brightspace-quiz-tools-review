{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coursecraft.component_package_receipt/1",
  "title": "CourseCraft Component Package Receipt",
  "type": "object",
  "required": [
    "schema",
    "package_title",
    "base_resource_code",
    "deterministic",
    "contract_sha256",
    "producer_files",
    "codes",
    "support_assets",
    "package_files",
    "zip",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "coursecraft.component_package_receipt/1"},
    "package_title": {"type": "string", "minLength": 1},
    "base_resource_code": {"type": "string", "minLength": 1},
    "deterministic": {"type": "boolean"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "producer_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileReceipt"}
    },
    "codes": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "support_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/supportAsset"}
    },
    "package_files": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/fileReceipt"}
    },
    "zip": {
      "allOf": [
        {"$ref": "#/$defs/fileReceipt"},
        {"properties": {"role": {"const": "package_zip"}}}
      ]
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)"}
    },
    "fileReceipt": {
      "type": "object",
      "required": ["path", "role", "bytes", "sha256", "extensions"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "role": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "supportAsset": {
      "type": "object",
      "required": ["source", "target", "role", "bytes", "sha256", "extensions"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/safePath"},
        "target": {"$ref": "#/$defs/safePath"},
        "role": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "extensions": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
